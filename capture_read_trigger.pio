.pio_version 1
.program snes_read_trigger
; RP2350B PIO2, GPIO base = 16
;
; Physical GP35 = CPU /RD
;
; IMPORTANT:
; WAIT GPIO indices are RELATIVE to the PIO GPIO base.
; Therefore physical GP35 is index 35-16 = 19.
;
; Detect one A-bus read cycle and notify PIO0 through cross-PIO IRQ1.
; PIO2 NEXT wraps to PIO0 on RP2350.

.wrap_target
    wait 0 gpio 19         ; physical GP35 /RD asserted (active low)
    irq next 1             ; set IRQ1 in PIO0
    wait 1 gpio 19         ; physical GP35 released
    nop
.wrap
