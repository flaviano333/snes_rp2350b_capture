.pio_version 1
.program snes_romsel_read_trigger
; RP2350B PIO2 GPIO base = 16.
;
; IMPORTANT:
;   WAIT GPIO indices are RELATIVE to the PIO GPIO base.
;   Physical GP35 => 35 - 16 = 19.
;
; Physical GP35 = CPU /RD       (active low)
; Physical GP36 = /ROMSEL       (active low, selected via JMP PIN config)
;
; Only notify PIO0 for genuine cartridge-ROM read cycles.

.wrap_target
start:
    wait 0 gpio 19       ; physical GP35 because PIO2 gpio_base=16
    jmp pin non_rom      ; configured JMP pin = physical GP36 (/ROMSEL)
    irq next 1
    wait 1 gpio 19       ; physical GP35 released
    jmp start

non_rom:
    wait 1 gpio 19
    jmp start
.wrap
