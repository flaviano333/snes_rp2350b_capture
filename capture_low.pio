.pio_version 1
.program snes_capture_low
; RP2350 PIO0, GPIO base = 0
;
; GP0      = PHI2
; GP1      = /WR (jmp pin)
; GP2-9    = D0-D7
; GP10-17  = raw address wires; firmware remaps them to A0-A7
;
; This state machine is the timing master.
; On each write cycle it signals IRQ0 in the NEXT PIO block (PIO1),
; allowing PIO1 to snapshot A8-A23 without any external jumper.
;
; in_base = GP2. IN PINS,16 reads GP2..GP17; C code reorders address bits.

.wrap_target
    wait 1 gpio 0          ; PHI2 high: address bus is stable
    nop [1]                ; brief settling time before sampling /WR
    jmp pin no_write       ; /WR high -> this is not a write cycle

    irq next 0             ; set IRQ0 in PIO1: snapshot high address now
    wait 0 gpio 0          ; data guaranteed valid at PHI2 falling edge

    mov isr, null
    in pins, 16            ; D0-D7 + A0-A7
    push block
    jmp cycle_done

no_write:
    wait 0 gpio 0          ; finish this bus cycle before trying again

cycle_done:
    nop
.wrap
