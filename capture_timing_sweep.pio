.pio_version 1
.program snes_wide_timing_sweep
; PIO0 GPIO window 0..31.
; Triggered by PIO0 IRQ1 from the /RD watcher.
;
; 16 atomic GP0..GP31 samples.
; Capture SM runs at clkdiv=2.0.
; Between sample starts: IN(1 cycle) + NOP[2](3 cycles) = 4 PIO cycles
; = 8 system clocks. At the normal 150 MHz sys clock this is ~53.3 ns.
; S0..S15 therefore span ~800 ns, wide enough to cross PHI2 transitions.

.wrap_target
    wait 1 irq 1
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
    nop [2]
    in pins, 32
.wrap
